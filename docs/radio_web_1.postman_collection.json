    {
      "name": "Pesquisa externa de rádios",
      "description": "Esta requisição não passa pelo ESP32. A página index.html consulta o serviço público Radio Browser diretamente do navegador e tenta outros servidores se o primeiro falhar.",
      "item": [
        {
          "name": "Pesquisar no Radio Browser",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{radioBrowserBaseUrl}}/json/stations/search?hidebroken=true&order=votes&reverse=true&limit=30&countrycode=BR&name=Antena",
              "host": ["{{radioBrowserBaseUrl}}"],
              "path": ["json", "stations", "search"],
              "query": [
                {
                  "key": "hidebroken",
                  "value": "true"
                },
                {
                  "key": "order",
                  "value": "votes"
                },
                {
                  "key": "reverse",
                  "value": "true"
                },
                {
                  "key": "limit",
                  "value": "30"
                },
                {
                  "key": "countrycode",
                  "value": "BR"
                },
                {
                  "key": "name",
                  "value": "Antena"
                }
              ]
            },
            "description": "Replica a pesquisa externa da interface. countrycode, name e uma query tag podem ser combinados. A prévia de áudio não é uma rota do ESP32: o navegador abre diretamente url_resolved ou url retornada por esta consulta."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Resposta é uma lista\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
