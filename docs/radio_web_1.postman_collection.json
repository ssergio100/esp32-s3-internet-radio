{
  "info": {
    "_postman_id": "7e3d9e7d-6ac0-4f2f-9c0f-0a16a238f501",
    "name": "Rádio Web ESP32-S3",
    "description": "Coleção para testar todas as rotas de dados implementadas pelo firmware. Defina baseUrl com o IP atual do rádio, sem barra no final. A API cobre telemetria, rádios, alarmes, catálogos e upload. Ela ainda não comanda volume, fonte ativa, estação em reprodução, Player ou Relógio, nem permite baixar ou excluir arquivos. A pesquisa do Radio Browser é externa ao ESP32 e está em uma pasta separada. Requisições marcadas como destrutivas alteram a FFat.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://192.168.1.100",
      "type": "string",
      "description": "Endereço atual do rádio, sem barra no final."
    },
    {
      "key": "radioId",
      "value": "1",
      "type": "string",
      "description": "ID de uma rádio existente. Confirme em Listar rádios antes de atualizar alarmes ou excluir uma estação."
    },
    {
      "key": "alarmeId",
      "value": "1",
      "type": "string",
      "description": "ID de um alarme existente. Confirme em Listar alarmes antes de atualizar ou excluir."
    },
    {
      "key": "arquivoAlarme",
      "value": "/sons/alarme.mp3",
      "type": "string",
      "description": "Caminho de um MP3 existente no catálogo do microSD."
    },
    {
      "key": "radioBrowserBaseUrl",
      "value": "https://de1.api.radio-browser.info",
      "type": "string",
      "description": "Servidor externo usado pela pesquisa de rádios da interface web."
    }
  ],
  "item": [
    {
      "name": "Diagnóstico",
      "description": "Telemetria somente de leitura.",
      "item": [
        {
          "name": "Obter status do sistema",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "status"]
            },
            "description": "Retorna áudio, alarme, Wi-Fi, memória e uptime. Não altera o estado do rádio."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Resposta contém os campos centrais\", function () {",
                  "    const dados = pm.response.json();",
                  "    pm.expect(dados).to.have.property(\"estado\");",
                  "    pm.expect(dados).to.have.property(\"wifiConectado\");",
                  "    pm.expect(dados).to.have.property(\"ramLivre\");",
                  "    pm.expect(dados).to.have.property(\"uptimeMs\");",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Rádios",
      "description": "Cadastro de estações persistido em radios.json. Não troca imediatamente a estação em reprodução.",
      "item": [
        {
          "name": "Listar rádios",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/radios",
              "host": ["{{baseUrl}}"],
              "path": ["api", "radios"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Resposta é uma lista\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Adicionar rádio",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Rádio criada pelo Postman\",\n  \"url\": \"https://exemplo.com/stream\",\n  \"estrelas\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/radios",
              "host": ["{{baseUrl}}"],
              "path": ["api", "radios"]
            },
            "description": "Cria uma estação com novo ID. Limites atuais: nome até 63 caracteres, URL até 511 e estrelas entre 1 e 5."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Operação confirmada\", function () { pm.expect(pm.response.json().sucesso).to.eql(true); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Excluir rádio (destrutivo)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/radios?id={{radioId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "radios"],
              "query": [
                {
                  "key": "id",
                  "value": "{{radioId}}",
                  "description": "A API recusa excluir a última estação."
                }
              ]
            },
            "description": "ATENÇÃO: remove da FFat a rádio indicada por radioId. Alarmes que referenciem uma estação removida passam a usar o som padrão."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Operação confirmada\", function () { pm.expect(pm.response.json().sucesso).to.eql(true); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
